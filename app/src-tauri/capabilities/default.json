{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права главного окна. Только базовые: всё остальное окно просит у ядра через команды.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
